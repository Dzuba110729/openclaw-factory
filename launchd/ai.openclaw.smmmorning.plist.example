<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.smmmorning</string>

    <key>Comment</key>
    <string>SMM morning brief: shell gathers plan+comments, wakes LLM only when there is something to report</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>{{HOME}}/openclaw-factory/agents/smm/scripts/smm-morning.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict><key>OWNER_TG_ID</key><string>{{OWNER_TG_ID}}</string>
      <key>HOME</key>
      <string>{{HOME}}</string>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:{{HOME}}/.local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.openclaw/logs/smm-morning.err.log</string>
  </dict>
</plist>
