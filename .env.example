# Образец. Реальные значения кладутся в .env рядом с агентом (agents/<id>/.env
# или ~/.openclaw/agents/<id>/.env) и в git не попадают.

# Владелец (Telegram ID) — кому гейты и проверки шлют уведомления
OWNER_TG_ID=

# smm — ВКонтакте (групповой токен сообщества: управление, стена, сообщения, Long Poll)
VK_TOKEN=
VK_GROUP_ID=
VK_USER_TOKEN=

# designer — генерация картинок и видео (LaoZhang)
LAOZHANG_API_KEY=

# gateway — эмбеддинги памяти и распознавание голосовых
MISTRAL_API_KEY=
