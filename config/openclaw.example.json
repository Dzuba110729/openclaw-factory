  "env": {
    "MISTRAL_API_KEY": "{{MISTRAL_API_KEY}}"
  },
  "tools": {
    "profile": "coding",
    "media": {
      "audio": {
        "enabled": true,
        "models": [
          {
            "provider": "mistral",
            "model": "voxtral-mini-latest"
          }
        ]
      }
    },
    "agentToAgent": {
      "enabled": true
    },
    "sessions": {
      "visibility": "all"
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "fs": {
      "workspaceOnly": false
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": {
        "mode": "partial"
      },
      "accounts": {
        "coordinator": {
          "botToken": "{{TG_BOT_TOKEN_COORDINATOR}}",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "{{OWNER_TG_ID}}"
          ],
          "groupPolicy": "allowlist",
          "groupAllowFrom": [
            "{{OWNER_TG_ID}}"
          ],
          "groups": {
            "*": {
              "requireMention": true
            }
          },
          "streaming": {
            "mode": "partial"
          },
