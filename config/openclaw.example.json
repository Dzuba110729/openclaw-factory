  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "{{GATEWAY_TOKEN}}"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "anthropic": {
        "enabled": false
      },
      "openai": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      }
    }
  },
  "bindings": [
    {
      "agentId": "coordinator",
      "match": {
        "channel": "telegram",
        "accountId": "coordinator"
      }
    },
